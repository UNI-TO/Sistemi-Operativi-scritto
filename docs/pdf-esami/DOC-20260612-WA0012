  soluzione: `/* Esercizio 5 - free_between() */

#include <stdlib.h>

typedef struct _node {
    int           value;
    struct _node *next;
} node;


node *free_between(node *head, int a, int b) {
    /* 1. elimina gli eventuali nodi da scartare in TESTA alla lista */
    while (head != NULL && head->value >= a && head->value <= b) {
        node *tmp = head;
        head = head->next;
        free(tmp);
    }

    /* 2. scorri il resto guardando il nodo successivo (prev->next) */
    node *prev = head;
    while (prev != NULL && prev->next != NULL) {
        if (prev->next->value >= a && prev->next->value <= b) {
            node *tmp = prev->next;
            prev->next = tmp->next;    /* scavalca il nodo da eliminare */
            free(tmp);
        } else {
            prev = prev->next;         /* avanza */
        }
    }
    return head;
}
