function openEsercizioC(idx){
  currentEsC = idx;
  solutionVisible = false;
  const e = ESERCIZI_C[idx];
  const saved = localStorage.getItem(ecKey(e.id)) || '';

  let html = '<div class="home-card" style="text-align:left">';
  html += '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:8px">';
  html += '<h2 style="margin:0">' + esc(e.titolo) + '</h2>';
  html += '<div><button class="btn-ghost" onclick="openEserciziC()">&larr; Lista esercizi</button> ';
  html += '<button class="btn-ghost" onclick="goHome()">Home</button></div>';
  html += '</div>';

  html += '<div><strong>Prototipo:</strong></div>';
  html += '<div class="code-block">' + esc(e.prototipo) + '</div>';

  if(e.tipoDef && e.tipoDef.length > 0){
    html += '<div><strong>Definizioni di tipo:</strong></div>';
    html += '<div class="code-block">' + esc(e.tipoDef) + '</div>';
  }

  html += '<div><strong>Traccia:</strong></div>';
  html += '<div class="traccia-box">' + esc(e.traccia) + '</div>';

  html += '<div><strong>Esempio:</strong></div>';
  html += '<div class="esempio-box">' + esc(e.esempio) + '</div>';

  html += '<div style="margin-top:18px"><strong>La tua soluzione:</strong></div>';
  html += '<textarea id="ec-editor" class="code-editor" spellcheck="false" placeholder="// scrivi qui la tua soluzione in C\n// usa Tab per indentare\n\n' + esc(e.prototipo) + ' {\n    \n}" oninput="ecSave()">' + esc(saved) + '</textarea>';

  html += '<div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px">';
  html += '<button class="btn-primary" onclick="ecCopyForClaude()">Copia per Claude</button>';
  html += '<button class="btn-ghost" onclick="ecToggleSolution()">Mostra/nascondi soluzione</button>';
  html += '<button class="btn-ghost" onclick="ecClear()">Svuota editor</button>';
  html += '</div>';
  html += '<p id="ec-msg" style="color:#157a41;font-weight:600;min-height:20px;margin-top:8px"></p>';

  html += '<div id="ec-solution"></div>';

  html += '</div>';
  document.getElementById('esercizi-c').innerHTML = html;
  showSection('esercizi-c');

  // gestione Tab dentro l'editor (inserisce spazi invece che cambiare focus)
  const ed = document.getElementById('ec-editor');
  ed.addEventListener('keydown', function(ev){
    if(ev.key === 'Tab'){
      ev.preventDefault();
      const s = ed.selectionStart, e = ed.selectionEnd;
      ed.value = ed.value.substring(0,s) + '    ' + ed.value.substring(e);
      ed.selectionStart = ed.selectionEnd = s + 4;
      ecSave();
    }
  });
}

function ecSave(){
  if(currentEsC === null) return;
  const e = ESERCIZI_C[currentEsC];
  const ed = document.getElementById('ec-editor');
  if(ed) localStorage.setItem(ecKey(e.id), ed.value);
}

function ecClear(){
  if(currentEsC === null) return;
  if(!confirm('Svuotare l\'editor di questo esercizio? Il codice salvato andrà perso.')) return;
  const e = ESERCIZI_C[currentEsC];
  localStorage.removeItem(ecKey(e.id));
  const ed = document.getElementById('ec-editor');
  if(ed) ed.value = '';
  ecMsg('Editor svuotato.');
}

function ecMsg(t){
  const m = document.getElementById('ec-msg');
  if(m) m.textContent = t;
}

function ecToggleSolution(){
  if(currentEsC === null) return;
  solutionVisible = !solutionVisible;
  const e = ESERCIZI_C[currentEsC];
  const box = document.getElementById('ec-solution');
  if(!box) return;
  if(solutionVisible){
    box.innerHTML = '<div style="margin-top:18px"><strong>Soluzione di riferimento:</strong></div>'
      + '<div class="code-block">' + esc(e.soluzione) + '</div>';
  } else {
    box.innerHTML = '';
  }
}

function ecBuildClaudePrompt(){
  if(currentEsC === null) return '';
  const e = ESERCIZI_C[currentEsC];
  const ed = document.getElementById('ec-editor');
  const codice = ed ? ed.value : '';
  let out = 'ANALISI SOLUZIONE ESERCIZIO C — Sistemi Operativi\n';
  out += '======================================================\n\n';
  out += 'Esercizio: ' + e.titolo + '\n\n';
  out += 'Prototipo: ' + e.prototipo + '\n\n';
  if(e.tipoDef && e.tipoDef.length > 0){
    out += 'Definizioni di tipo:\n' + e.tipoDef + '\n\n';
  }
  out += 'Traccia:\n' + e.traccia + '\n\n';
  out += 'Esempio:\n' + e.esempio + '\n\n';
  out += '------------------------------------------------------\n';
  out += 'LA MIA SOLUZIONE:\n\n';
  out += codice + '\n\n';
  out += '------------------------------------------------------\n';
  out += 'Per favore analizza la mia soluzione: dimmi se è corretta, ';
  out += 'se ci sono bug o casi limite non gestiti, se posso migliorarla, ';
  out += 'e indicami con precisione cosa cambiare.\n';
  return out;
}

function ecCopyForClaude(){
  const txt = ecBuildClaudePrompt();
  if(!txt){ ecMsg('Apri prima un esercizio.'); return; }
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(
      () => ecMsg('Testo copiato! Incollalo nella chat con Claude.'),
      () => ecFallbackCopy(txt)
    );
  } else {
    ecFallbackCopy(txt);
  }
}

function ecFallbackCopy(txt){
  const ta = document.createElement('textarea');
  ta.value = txt; ta.style.position='fixed'; ta.style.opacity='0';
  document.body.appendChild(ta); ta.select();
  try { document.execCommand('copy'); ecMsg('Testo copiato! Incollalo nella chat con Claude.'); }
  catch (e) { ecMsg('Impossibile copiare. Seleziona il testo manualmente.'); }
  document.body.removeChild(ta);
}

