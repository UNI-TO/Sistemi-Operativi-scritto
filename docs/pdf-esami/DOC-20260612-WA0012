  html += '</div>';
  html += '<p id="flagMsg" style="color:#157a41;font-weight:600;min-height:20px"></p>';
  html += '</div>';
  arr.forEach((idx,n) => { html += renderFlaggedCard(idx,n); });
  document.getElementById('flagview').innerHTML = html;
