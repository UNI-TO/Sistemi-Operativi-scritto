  soluzione: `#include <stdlib.h>
#include <string.h>

typedef struct _node {
    char *str;
    struct _node *next;
} node;

char *list_to_string(node *head) {
    char *s, *s_next;
    int len, len_next;

    if (head == NULL) {
        return NULL;
    }
    if (head->next == NULL) {
        /* caso base: ultimo nodo, copia la sua stringa + terminatore */
        len = strlen(head->str);
        s = malloc(len + 1);       /* stringa + zero terminazione */
        memcpy(s, head->str, len);
        s[len] = 0;                /* aggiunge terminatore */
    } else {
        /* ricorsione sul resto della lista */
        s_next = list_to_string(head->next);
        len_next = strlen(s_next);
        len = strlen(head->str);
        s = malloc(len + len_next + 2);   /* le due stringhe + spazio + zero */
        memcpy(s, head->str, len);
        s[len] = ' ';              /* aggiunge lo spazio */
        memcpy(s + len + 1, s_next, len_next);
        s[len + len_next + 1] = 0; /* aggiunge terminatore */
        free(s_next);              /* libera la vecchia stringa */
    }
    return s;
