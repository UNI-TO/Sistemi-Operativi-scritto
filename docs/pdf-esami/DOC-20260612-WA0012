/* Indici delle domande di calcolo (paginazione, memoria, hard disk, scheduling, EAT, fork) */
const CALCOLO_IDX = [25,27,36,37,38,39,40,41,42,44,45,46,47,50,51,54,58,59,62,66,67,69,71,72,73,77,78,79,83,89,93,96,98,99,119,121,122,123,126];

/* ====================== STATO ====================== */
const N_QUESTIONS = 15;
let active = [];
let flagged = new Set();
let currentMode = 'esame';

function loadFlags(){
  try{
    const r = localStorage.getItem('so_sim_flagged');
    if(r) flagged = new Set(JSON.parse(r));
  }catch(e){}
}
function saveFlags(){
  try{ localStorage.setItem('so_sim_flagged', JSON.stringify([...flagged])); }catch(e){}
}

function shuffle(a){
  a = a.slice();
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]] = [a[j],a[i]];
  }
  return a;
}

function esc(s){
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function modeLabel(m){
  const mode = m || currentMode;
  if(mode === 'esame') return "Simulazione d'esame";
  if(mode === 'esercizi') return "Esercizi del professore";
  if(mode === 'calcolo') return "Pratica calcolo";
  return "Esplora libera";
}

function explBox(q){
  const idx = QUESTIONS.indexOf(q);
  const sp = (idx >= 0) ? SPIEGAZIONI[idx] : '';
  if(!sp) return '';
  return '<div class="spiegazione"><span class="sp-title">Perch&eacute; &mdash; ripassa questo</span>'+esc(sp)+'</div>';
}

/* ====================== CONTRASSEGNO ====================== */
function flagBtnHtml(idx){
  const on = flagged.has(idx);
  return '<button class="flag-btn'+(on?' on':'')+'" onclick="toggleFlag('+idx+',this)">'
       + (on ? '⚑ Contrassegnata' : '⚐ Contrassegna') + '</button>';
}

function syncFlagButton(btn, idx){
  const on = flagged.has(idx);
  btn.classList.toggle('on', on);
  btn.textContent = on ? '⚑ Contrassegnata' : '⚐ Contrassegna';
  const card = btn.closest('.q-card');
  if(card) card.classList.toggle('flagged', on);
}

function toggleFlag(idx, btn){
  if(flagged.has(idx)) flagged.delete(idx);
  else flagged.add(idx);
  saveFlags();
  updateFlagCount();
  const fv = document.getElementById('flagview');
  if(fv && !fv.classList.contains('hidden')){ openFlagView(); return; }
  if(btn) syncFlagButton(btn, idx);
}

function updateFlagCount(){
  const b = document.getElementById('flagHomeBtn');
  if(b) b.textContent = 'Domande contrassegnate (' + flagged.size + ')';
}

function showSection(name){
  ['home','quiz','results','flagview','explore','esercizi-c'].forEach(s => {
    document.getElementById(s).classList.toggle('hidden', s !== name);
  });
  document.getElementById('bar').classList.toggle('hidden', name !== 'quiz');
  window.scrollTo(0,0);
}

/* ====================== QUIZ ====================== */
function startQuiz(mode){
  currentMode = mode;
  let pool;
  if(mode === 'esame') pool = QUESTIONS.slice(0, N_ESAME);
  else if(mode === 'esercizi') pool = QUESTIONS.slice(N_ESAME);
  else if(mode === 'calcolo') pool = CALCOLO_IDX.map(i => QUESTIONS[i]);
  else pool = QUESTIONS;
  const picked = shuffle(pool).slice(0, N_QUESTIONS);
  active = picked.map(q => {
    const item = { q:q };
    if(q.type === 'mc'){
      item.opts = shuffle(q.options.map((t,i)=>({text:t, correct:i===q.correct})));
    } else {
      item.pool = shuffle(q.pool);
    }
    return item;
  });
  renderQuiz();
  showSection('quiz');
}

function renderQuiz(){
  let html = '<h2 class="section-title">' + modeLabel() + '</h2>';
  active.forEach((item, qi) => {
    const q = item.q;
    const idx = QUESTIONS.indexOf(q);
    html += '<div class="q-card'+(flagged.has(idx)?' flagged':'')+'">';
    html += '<div class="q-head"><span class="q-num">Domanda '+(qi+1)+'</span>'+flagBtnHtml(idx)+'</div>';
    html += '<div class="q-text">'+esc(q.text)+'</div>';
    if(q.pre){ html += '<div class="q-pre">'+esc(q.pre)+'</div>'; }

    if(q.type === 'mc'){
      item.opts.forEach((o, oi) => {
        html += '<label class="opt" onclick="markSel(this)">'
              + '<input type="radio" name="q'+qi+'" value="'+oi+'" onchange="updateProgress()">'
              + '<span class="opt-txt">'+esc(o.text)+'</span></label>';
      });
    } else {
      q.blanks.forEach((b, bi) => {
        let sel = '<select id="q'+qi+'_b'+bi+'" onchange="updateProgress()">';
        sel += '<option value="">— scegli —</option>';
        item.pool.forEach(opt => {
          sel += '<option value="'+esc(opt)+'">'+esc(opt)+'</option>';
        });
        sel += '</select>';
        html += '<div class="fill-row"><span class="fill-lbl">'+esc(b.label)+'</span>'+sel+'</div>';
      });
    }
    html += '</div>';
  });
  document.getElementById('quiz').innerHTML = html;
  updateProgress();
}

function markSel(label){
  const card = label.closest('.q-card');
  card.querySelectorAll('.opt').forEach(o => o.classList.remove('sel'));
  label.classList.add('sel');
}

function isAnswered(qi){
  const item = active[qi];
  if(item.q.type === 'mc'){
    return !!document.querySelector('input[name="q'+qi+'"]:checked');
  } else {
    return item.q.blanks.every((b,bi) => document.getElementById('q'+qi+'_b'+bi).value !== '');
  }
}

function updateProgress(){
  let done = 0;
  for(let i=0;i<active.length;i++){ if(isAnswered(i)) done++; }
  document.getElementById('progress').textContent = 'Risposte: '+done+' / '+active.length;
}

function submitQuiz(){
  let done = 0;
  for(let i=0;i<active.length;i++){ if(isAnswered(i)) done++; }
  if(done < active.length){
    if(!confirm('Hai risposto a '+done+' domande su '+active.length+'. Vuoi consegnare comunque?')) return;
  }
  showResults();
}

function showResults(){
  let totalScore = 0;
  let reviewHtml = '';

  active.forEach((item, qi) => {
    const q = item.q;
    const idx = QUESTIONS.indexOf(q);
    let qScore = 0;
    reviewHtml += '<div class="q-card review-q'+(flagged.has(idx)?' flagged':'')+'">';
    reviewHtml += '<div class="q-head"><span class="q-num">Domanda '+(qi+1)+'</span>'+flagBtnHtml(idx);

    if(q.type === 'mc'){
      const checked = document.querySelector('input[name="q'+qi+'"]:checked');
      const userIdx = checked ? parseInt(checked.value) : -1;
      const userOk = userIdx >= 0 && item.opts[userIdx].correct;
      qScore = userOk ? 1 : 0;
      reviewHtml += '<span class="tag '+(userOk?'ok':'ko')+'">'+(userOk?'Corretta':'Errata')+'</span></div>';
      reviewHtml += '<div class="q-text">'+esc(q.text)+'</div>';
      if(q.pre){ reviewHtml += '<div class="q-pre">'+esc(q.pre)+'</div>'; }
      item.opts.forEach((o, oi) => {
        let cls = 'opt';
        if(o.correct) cls += ' correct';
        else if(oi === userIdx) cls += ' wrong';
        let mark = '';
        if(o.correct) mark = ' ✔';
        else if(oi === userIdx) mark = ' ✘';
        reviewHtml += '<div class="'+cls+'"><span class="opt-txt">'+esc(o.text)+esc(mark)+'</span></div>';
      });
      if(userIdx < 0){
        reviewHtml += '<div class="fill-res wrong">Non hai risposto a questa domanda.</div>';
      }
      if(!userOk){ reviewHtml += explBox(q); }
    } else {
      let okCount = 0;
      const results = [];
      q.blanks.forEach((b, bi) => {
        const val = document.getElementById('q'+qi+'_b'+bi).value;
        const ok = val === b.correct;
        if(ok) okCount++;
        results.push({label:b.label, val:val, correct:b.correct, ok:ok});
      });
      qScore = okCount / q.blanks.length;
      const allOk = okCount === q.blanks.length;
      const tagCls = allOk ? 'ok' : (okCount===0 ? 'ko' : 'partial');
      const tagTxt = allOk ? 'Corretta' : (okCount===0 ? 'Errata' : 'Parziale ('+okCount+'/'+q.blanks.length+')');
      reviewHtml += '<span class="tag '+tagCls+'">'+tagTxt+'</span></div>';
      reviewHtml += '<div class="q-text">'+esc(q.text)+'</div>';
      if(q.pre){ reviewHtml += '<div class="q-pre">'+esc(q.pre)+'</div>'; }
      results.forEach(r => {
        reviewHtml += '<div class="fill-res '+(r.ok?'correct':'wrong')+'">';
        reviewHtml += '<strong>'+esc(r.label)+'</strong><br>';
        if(r.ok){
          reviewHtml += '<span class="ans-correct">'+esc(r.val)+'</span>';
        } else {
          if(r.val) reviewHtml += 'La tua risposta: <span class="ans-wrong">'+esc(r.val)+'</span><br>';
          else reviewHtml += '<em>Non hai risposto.</em><br>';
          reviewHtml += 'Risposta corretta: <span class="ans-correct">'+esc(r.correct)+'</span>';
        }
        reviewHtml += '</div>';
      });
      if(!allOk){ reviewHtml += explBox(q); }
    }
    reviewHtml += '</div>';
    totalScore += qScore;
  });

  const pct = Math.round(totalScore / active.length * 100);
  let verdict, color;
  if(pct >= 80){ verdict = 'Ottimo! Sei pronto.'; color = '#1f9d57'; }
  else if(pct >= 60){ verdict = 'Buon risultato, ancora qualche ripasso.'; color = '#1f3a93'; }
  else if(pct >= 50){ verdict = 'Sufficiente: rivedi gli argomenti sbagliati.'; color = '#8a6400'; }
  else { verdict = 'Da rivedere: riprova dopo aver ripassato.'; color = '#b13129'; }

  let html = '<div class="score-card">';
  html += '<div class="score-big">'+totalScore.toFixed(1)+' / '+active.length+'</div>';
  html += '<div class="score-pct">'+pct+'% di risposte corrette</div>';
  html += '<div class="score-mode">'+modeLabel()+'</div>';
  html += '<div class="verdict" style="color:'+color+'">'+verdict+'</div>';
  html += '<div style="margin-top:20px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap">';
  html += '<button class="btn-primary" onclick="startQuiz(\''+currentMode+'\')">Nuova simulazione</button>';
  html += '<button class="btn-ghost" onclick="openFlagView()">Domande contrassegnate</button>';
  html += '<button class="btn-ghost" onclick="goHome()">Torna all\'inizio</button>';
  html += '</div></div>';
  html += '<h2 class="section-title">Correzione domanda per domanda</h2>';
  html += reviewHtml;

  document.getElementById('results').innerHTML = html;
  showSection('results');
}


/* ====================== ESPLORA TUTTE LE DOMANDE ====================== */
let exploreState = { filter:'tutte', list:[], cursor:0, answers:{}, verified:{} };

function openExplore(){
  let html = '<div class="home-card" style="text-align:left">';
  html += '<h2 style="text-align:center">Esplora tutte le domande</h2>';
  html += '<p>Scorri una domanda alla volta. Rispondi e premi <strong>Verifica</strong>: vedrai subito la risposta corretta e la spiegazione, e potrai passare alla prossima.</p>';
  html += '<p>Da quale insieme di domande vuoi partire?</p>';
  html += '<div class="mode-grid" style="margin-top:14px">';
  html += '<button class="mode-btn" onclick="startExplore(\'tutte\')">'
        + '<span class="mode-title">Tutte le domande</span>'
        + '<span class="mode-desc">' + QUESTIONS.length + ' domande, esame + esercizi</span></button>';
  html += '<button class="mode-btn alt" onclick="startExplore(\'esame\')">'
        + '<span class="mode-title">Solo Simulazioni d\'esame</span>'
        + '<span class="mode-desc">' + N_ESAME + ' domande dalle prove ufficiali</span></button>';
  html += '<button class="mode-btn alt" onclick="startExplore(\'esercizi\')">'
        + '<span class="mode-title">Solo Esercizi del professore</span>'
        + '<span class="mode-desc">' + (QUESTIONS.length - N_ESAME) + ' domande dagli esercizi</span></button>';
  html += '<button class="mode-btn calcolo" onclick="startExplore(\'calcolo\')">'
        + '<span class="mode-title">Solo domande di calcolo</span>'
        + '<span class="mode-desc">' + CALCOLO_IDX.length + ' domande numeriche</span></button>';
  html += '</div>';
  html += '<div style="text-align:center;margin-top:20px"><button class="btn-ghost" onclick="goHome()">Torna all\'inizio</button></div>';
  html += '</div>';
  document.getElementById('explore').innerHTML = html;
  showSection('explore');
}

function startExplore(filter){
  exploreState.filter = filter;
  if(filter === 'tutte') exploreState.list = QUESTIONS.map((_,i)=>i);
  else if(filter === 'esame') exploreState.list = QUESTIONS.map((_,i)=>i).filter(i => i < N_ESAME);
  else if(filter === 'esercizi') exploreState.list = QUESTIONS.map((_,i)=>i).filter(i => i >= N_ESAME);
  else if(filter === 'calcolo') exploreState.list = CALCOLO_IDX.slice();
  exploreState.cursor = 0;
  exploreState.answers = {};
  exploreState.verified = {};
  renderExploreQ();
}

function exploreFilterLabel(){
  return ({tutte:'Tutte le domande', esame:'Simulazioni d\'esame', esercizi:'Esercizi del professore', calcolo:'Domande di calcolo'})[exploreState.filter] || exploreState.filter;
}

function renderExploreQ(){
  const idx = exploreState.list[exploreState.cursor];
  const q = QUESTIONS[idx];
  const poolLbl = idx < N_ESAME ? "Simulazione d'esame" : 'Esercizi del professore';
  const isVerified = exploreState.verified[idx];

  let html = '<div class="home-card" style="text-align:left">';
  html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px">';
  html += '<div><strong>' + exploreFilterLabel() + '</strong> &middot; Domanda ' + (exploreState.cursor+1) + ' / ' + exploreState.list.length;
  html += ' <span class="tag" style="background:#e3e8f2;color:#1f3a93;margin-left:8px">' + esc(poolLbl) + '</span></div>';
  html += '<div style="display:flex;gap:8px"><button class="btn-ghost" onclick="openExplore()">Cambia filtro</button><button class="btn-ghost" onclick="goHome()">Esci</button></div>';
  html += '</div>';

  html += '<div class="q-card' + (flagged.has(idx)?' flagged':'') + (isVerified?' review-q':'') + '">';
  html += '<div class="q-head"><span class="q-num">id ' + idx + '</span>' + flagBtnHtml(idx);
  if(isVerified){
    const v = exploreState.verified[idx];
    if(v.allOk) html += '<span class="tag ok">Corretta</span>';
    else if(v.partial !== undefined && v.partial > 0) html += '<span class="tag partial">Parziale (' + v.partial + '/' + v.total + ')</span>';
    else html += '<span class="tag ko">Errata</span>';
  }
  html += '</div>';
  html += '<div class="q-text">' + esc(q.text) + '</div>';
  if(q.pre){ html += '<div class="q-pre">' + esc(q.pre) + '</div>'; }

  if(q.type === 'mc'){
    const user = (exploreState.answers[idx] !== undefined) ? exploreState.answers[idx] : -1;
    q.options.forEach((opt, oi) => {
      let cls = 'opt';
      let mark = '';
      if(isVerified){
        if(oi === q.correct){ cls += ' correct'; mark = ' ✔'; }
        else if(oi === user){ cls += ' wrong'; mark = ' ✘'; }
        html += '<div class="' + cls + '"><span class="opt-txt">' + esc(opt) + esc(mark) + '</span></div>';
      } else {
        html += '<label class="opt' + (oi===user?' sel':'') + '" onclick="markSel(this); exploreSetAnswer(' + idx + ',' + oi + ')">'
              + '<input type="radio" name="exq" value="' + oi + '"' + (oi===user?' checked':'') + '>'
              + '<span class="opt-txt">' + esc(opt) + '</span></label>';
      }
    });
  } else {
    q.blanks.forEach((b, bi) => {
      const userAns = (exploreState.answers[idx] && exploreState.answers[idx][bi] !== undefined) ? exploreState.answers[idx][bi] : '';
      if(isVerified){
        const ok = userAns === b.correct;
        html += '<div class="fill-res ' + (ok?'correct':'wrong') + '">';
        html += '<strong>' + esc(b.label) + '</strong><br>';
        if(ok){ html += '<span class="ans-correct">' + esc(userAns) + '</span>'; }
        else {
          if(userAns) html += 'La tua risposta: <span class="ans-wrong">' + esc(userAns) + '</span><br>';
          else html += '<em>Non hai risposto.</em><br>';
          html += 'Risposta corretta: <span class="ans-correct">' + esc(b.correct) + '</span>';
        }
        html += '</div>';
      } else {
        let sel = '<select id="exb' + bi + '" onchange="exploreSetBlank(' + idx + ',' + bi + ',this.value)">';
        sel += '<option value="">— scegli —</option>';
        q.pool.forEach(opt => {
          sel += '<option value="' + esc(opt) + '"' + (opt===userAns?' selected':'') + '>' + esc(opt) + '</option>';
        });
        sel += '</select>';
        html += '<div class="fill-row"><span class="fill-lbl">' + esc(b.label) + '</span>' + sel + '</div>';
      }
    });
  }

  if(isVerified){ html += explBox(q); }
  html += '</div>';

  html += '<div style="display:flex;gap:10px;justify-content:space-between;margin-top:16px;flex-wrap:wrap">';
  html += '<button class="btn-ghost" onclick="exploreNav(-1)"' + (exploreState.cursor===0?' disabled':'') + '>&larr; Precedente</button>';
  if(!isVerified){
    html += '<button class="btn-primary" onclick="exploreVerify(' + idx + ')">Verifica</button>';
  } else {
    html += '<button class="btn-ghost" onclick="exploreReset(' + idx + ')">Riprova questa</button>';
  }
  html += '<button class="btn-primary" onclick="exploreNav(1)"' + (exploreState.cursor===exploreState.list.length-1?' disabled':'') + '>Prossima &rarr;</button>';
  html += '</div>';

  html += '</div>';
  document.getElementById('explore').innerHTML = html;
  window.scrollTo(0,0);
}

function exploreSetAnswer(idx, val){ exploreState.answers[idx] = val; }

function exploreSetBlank(idx, bi, val){
  if(!exploreState.answers[idx]) exploreState.answers[idx] = {};
  exploreState.answers[idx][bi] = val;
}

function exploreVerify(idx){
  const q = QUESTIONS[idx];
  if(q.type === 'mc'){
    const user = exploreState.answers[idx];
    if(user === undefined){ alert('Seleziona prima una risposta.'); return; }
    exploreState.verified[idx] = { allOk: user === q.correct };
  } else {
    const ans = exploreState.answers[idx] || {};
    let okCount = 0;
    q.blanks.forEach((b,bi) => { if(ans[bi] === b.correct) okCount++; });
    exploreState.verified[idx] = { allOk: okCount === q.blanks.length, partial: okCount, total: q.blanks.length };
  }
  renderExploreQ();
}

function exploreReset(idx){
  delete exploreState.verified[idx];
  delete exploreState.answers[idx];
  renderExploreQ();
}

function exploreNav(delta){
  const next = exploreState.cursor + delta;
  if(next < 0 || next >= exploreState.list.length) return;
  exploreState.cursor = next;
  renderExploreQ();
}


