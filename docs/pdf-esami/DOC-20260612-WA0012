    int best = -1;        /* indice della sequenza migliore finora */
    int best_neg = -1;    /* numero di negativi della migliore     */

    for (int i = 0; i < length; i++) {
        /* conta gli elementi strettamente negativi della sequenza i */
        int neg = 0;
