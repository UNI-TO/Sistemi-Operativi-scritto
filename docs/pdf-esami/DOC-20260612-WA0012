function renderFlaggedCard(idx, n){
  const q = QUESTIONS[idx];
  const pool = idx < N_ESAME ? "Simulazione d'esame" : 'Esercizi del professore';
  let h = '<div class="q-card review-q flagged">';
  h += '<div class="q-head"><span class="q-num">Contrassegnata '+(n+1)+'</span>'+flagBtnHtml(idx)
     + '<span class="tag" style="background:#e3e8f2;color:#1f3a93">'+esc(pool)+'</span></div>';
  h += '<div class="q-text">'+esc(q.text)+'</div>';
  if(q.pre){ h += '<div class="q-pre">'+esc(q.pre)+'</div>'; }
  if(q.type === 'mc'){
    q.options.forEach((o,i) => {
      h += '<div class="opt'+(i===q.correct?' correct':'')+'"><span class="opt-txt">'
         + esc(o)+(i===q.correct?esc(' ✔'):'')+'</span></div>';
    });
  } else {
    q.blanks.forEach(b => {
      h += '<div class="fill-res correct"><strong>'+esc(b.label)+'</strong><br>'
         + '<span class="ans-correct">'+esc(b.correct)+'</span></div>';
    });
  }
  h += explBox(q);
  h += '</div>';
  return h;
}

function buildFlaggedText(){
  const arr = [...flagged].sort((a,b)=>a-b);
  let out = 'DOMANDE CONTRASSEGNATE - Simulatore Esame Sistemi Operativi\n';
  out += 'Chiedo a Claude un approfondimento sulle seguenti ' + arr.length + ' domande.\n';
  out += '======================================================\n\n';
  arr.forEach((idx,n) => {
    const q = QUESTIONS[idx];
    const pool = idx < N_ESAME ? "Simulazione d'esame" : 'Esercizi del professore';
    out += '### DOMANDA ' + (n+1) + '  (id ' + idx + ', pool: ' + pool + ')\n';
    out += q.text.replace(/\n+/g,' ') + '\n';
    if(q.pre) out += '\n' + q.pre + '\n';
    out += '\n';
    if(q.type === 'mc'){
      q.options.forEach((o,i) => {
        out += (i===q.correct ? '>> CORRETTA: ' : '   opzione  : ') + o.replace(/\n/g,' / ') + '\n';
      });
    } else {
      out += 'Completamenti corretti:\n';
      q.blanks.forEach(b => { out += '   ' + b.label + '  =>  ' + b.correct + '\n'; });
    }
    out += '\nSpiegazione gia presente nel simulatore:\n' + SPIEGAZIONI[idx] + '\n';
    out += '\n------------------------------------------------------\n\n';
  });
  out += 'Per favore approfondisci questi argomenti e chiarisci i miei dubbi.\n';
  return out;
}

function flagMsg(t){
  const m = document.getElementById('flagMsg');
  if(m) m.textContent = t;
}

function copyFlagged(){
  const txt = buildFlaggedText();
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(
      () => flagMsg('Testo copiato! Incollalo nella chat con Claude e chiedi i chiarimenti.'),
      () => fallbackCopy(txt)
    );
  } else {
    fallbackCopy(txt);
  }
}

function fallbackCopy(txt){
  const ta = document.createElement('textarea');
  ta.value = txt;
  ta.style.position = 'fixed'; ta.style.left = '-9999px';
  document.body.appendChild(ta);
  ta.select();
  try{
    document.execCommand('copy');
    flagMsg('Testo copiato! Incollalo nella chat con Claude.');
  }catch(e){
    flagMsg('Copia non riuscita: usa il pulsante Scarica .txt.');
  }
  document.body.removeChild(ta);
}

function downloadFlagged(){
  const blob = new Blob([buildFlaggedText()], {type:'text/plain;charset=utf-8'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'domande_da_chiarire.txt';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(a.href), 1500);
  flagMsg('File "domande_da_chiarire.txt" scaricato. Salvalo nella cartella "Sistemi Operativi" e chiedi a Claude di leggerlo.');
}

function clearFlags(){
  if(flagged.size === 0) return;
  if(!confirm('Vuoi rimuovere il contrassegno da tutte le ' + flagged.size + ' domande?')) return;
  flagged.clear();
  saveFlags();
  updateFlagCount();
  openFlagView();
}

