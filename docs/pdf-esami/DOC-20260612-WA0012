int *greater_than(int *a, int *b, const int a_length, const int b_length) {
    if (a == NULL || b == NULL || a_length <= 0) return NULL;

    int *r = malloc(a_length * sizeof(int));

    for (int i = 0; i < a_length; i++) {
        int count = 0;
        for (int j = 0; j < b_length; j++) {
            if (b[j] > a[i]) count++;
        }
        r[i] = count;
